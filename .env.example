# ===== Backend model config =====
# Use MODEL_PROVIDER=gemini for native Gemini via langchain-google-genai.
# Use MODEL_PROVIDER=openai for OpenAI-compatible endpoints and fill BASE_URL.
MODEL_PROVIDER=gemini
ARK_API_KEY=your_api_key
GOOGLE_API_KEY=
MODEL=gemini-3.1-flash-lite-preview
BASE_URL=
AGENT_TOOL_MODE=auto
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
HYBRID_RRF_K=60
HYBRID_CANDIDATE_POOL=8
SUMMARY_TRIGGER_MESSAGES=10
SUMMARY_KEEP_RECENT=6

# ===== Optional LangSmith =====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MY_agent
LANGSMITH_TRACING=true

# ===== Optional RAGFlow HTTP bridge =====
# If MY_agent runs in Docker and RAGFlow runs on the host machine on Windows,
# you can often use http://host.docker.internal as the hostname.
RAGFLOW_ENABLED=false
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_SEARCH_PATH=/api/v1/retrieval
RAGFLOW_INGEST_PATH=/api/v1/documents
RAGFLOW_DATASET_ID=
RAGFLOW_DATASET_NAME=MY_agent_laws
RAGFLOW_DATASET_CHUNK_METHOD=laws
RAGFLOW_DATASET_DESCRIPTION=Dataset auto-created by MY_agent for legal documents.
RAGFLOW_AUTO_CREATE_DATASET=true

# ===== App config =====
FRONTEND_ORIGIN=http://127.0.0.1:5173
SQLITE_PATH=data/app.db
